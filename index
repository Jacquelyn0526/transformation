<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Beaver Computation — Transformations Quiz (Interactive)</title>
  <meta name="description" content="Interactive quiz practicing mirror (M) and 90° clockwise rotation (R) compositions. 15 questions, 45-minute timer, instant detailed feedback." />
  <style>
    :root{
      --bg:#f6fbff;
      --card:#ffffff;
      --accent:#ff6b6b;
      --accent2:#4f46e5;
      --muted:#6b7280;
      --good:#16a34a;
      --bad:#dc2626;
      --glass: rgba(255,255,255,0.6);
    }
    html,body{height:100%}
    body{
      margin:0;
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial;
      background: linear-gradient(180deg,#e6f0ff 0%, #f6fbff 50%, #fffaf0 100%);
      color:#0f172a;
      -webkit-font-smoothing:antialiased;
      -moz-osx-font-smoothing:grayscale;
      padding:20px;
    }
    header{
      display:flex;
      gap:16px;
      align-items:center;
      margin-bottom:18px;
    }
    .logo{
      width:84px;
      height:84px;
      border-radius:14px;
      background:linear-gradient(135deg,var(--accent2),#06b6d4);
      display:flex;
      align-items:center;
      justify-content:center;
      color:white;
      box-shadow:0 8px 24px rgba(79,70,229,0.18);
      flex-shrink:0;
    }
    .logo svg{width:56px;height:56px}
    h1{font-size:1.4rem;margin:0}
    p.lead{margin:4px 0 0 0;color:var(--muted)}
    .topbar{
      margin-left:auto;
      display:flex;
      gap:12px;
      align-items:center;
    }
    .timer{
      background:linear-gradient(90deg,#fff,#f3f7ff);
      border:1px solid rgba(15,23,42,0.06);
      padding:8px 12px;
      border-radius:10px;
      font-weight:700;
      color:var(--accent2);
      display:flex;
      gap:8px;
      align-items:center;
      box-shadow:0 6px 18px rgba(79,70,229,0.06);
    }
    main{max-width:1100px;margin:18px auto 80px auto}
    .quiz{
      display:grid;
      gap:14px;
    }
    .card{
      background:var(--card);
      border-radius:12px;
      padding:14px;
      box-shadow: 0 6px 18px rgba(2,6,23,0.04);
      display:flex;
      gap:12px;
      align-items:flex-start;
      border:1px solid rgba(2,6,23,0.03);
    }
    .clip{
      width:84px;
      height:84px;
      flex-shrink:0;
      border-radius:10px;
      display:flex;
      align-items:center;
      justify-content:center;
      background:linear-gradient(180deg, rgba(79,70,229,0.06), rgba(6,182,212,0.04));
      border:1px dashed rgba(79,70,229,0.06);
    }
    .qbody{flex:1}
    .qhead{display:flex;align-items:center;gap:10px;margin-bottom:8px}
    .qnum{font-weight:800;color:var(--accent2);font-size:0.95rem}
    .qtext{color:#0b1220;font-weight:600}
    .sequence{font-family:ui-monospace, SFMono-Regular, Menlo, Monaco, "Roboto Mono", monospace;background:#f3f6ff;padding:6px 8px;border-radius:8px;color:var(--accent2);margin-left:auto;border:1px solid rgba(79,70,229,0.06)}
    .options{display:flex;flex-wrap:wrap;gap:8px;margin-top:8px}
    .option{
      background:linear-gradient(180deg,#ffffff,#fbfdff);
      border:1px solid rgba(2,6,23,0.06);
      padding:10px 12px;border-radius:10px;cursor:pointer;min-width:220px;
      display:flex;gap:10px;align-items:center;
      transition:transform .12s ease, box-shadow .12s ease;
    }
    .option:hover{transform:translateY(-4px);box-shadow:0 10px 30px rgba(2,6,23,0.06)}
    .option input{accent-color:var(--accent2)}
    .explain{margin-top:10px;color:var(--muted);font-size:0.95rem}
    .controls{display:flex;gap:12px;align-items:center;justify-content:space-between;margin-top:18px}
    .btn{
      background:linear-gradient(90deg,var(--accent2),#06b6d4);
      color:white;padding:10px 14px;border-radius:10px;border:none;font-weight:700;cursor:pointer;
      box-shadow:0 10px 30px rgba(79,70,229,0.12);
    }
    .btn.secondary{background:transparent;color:var(--accent2);border:1px solid rgba(79,70,229,0.12);box-shadow:none}
    .results{margin-top:18px;padding:12px;border-radius:10px;background:linear-gradient(180deg,#ffffff,#fbfffb);border:1px solid rgba(16,185,129,0.06)}
    .correct{color:var(--good);font-weight:700}
    .wrong{color:var(--bad);font-weight:700}
    .small{font-size:0.92rem;color:var(--muted)}
    footer{max-width:1100px;margin:28px auto 60px auto;color:var(--muted);font-size:0.95rem}
    /* responsive */
    @media (max-width:820px){
      .card{flex-direction:column;align-items:stretch}
      .sequence{margin-left:0}
      .topbar{display:none}
    }
  </style>
</head>
<body>
  <header>
    <div class="logo" aria-hidden="true">
      <!-- playful beaver clipart (simple SVG) -->
      <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Beaver icon">
        <rect width="64" height="64" rx="12" fill="white" opacity="0.06"/>
        <path d="M18 40c0-8 6-14 14-14s14 6 14 14v6H18v-6z" fill="#FFB86B"/>
        <circle cx="28" cy="34" r="3" fill="#3B3B3B"/>
        <circle cx="36" cy="34" r="3" fill="#3B3B3B"/>
        <path d="M26 44c2 2 10 2 12 0" stroke="#3B3B3B" stroke-width="2" stroke-linecap="round"/>
        <path d="M12 44c0 6 8 10 20 10s20-4 20-10" stroke="#7C3AED" stroke-opacity="0.12" stroke-width="4" stroke-linecap="round"/>
      </svg>
    </div>

    <div>
      <h1>Beaver Computation — Transformations Quiz</h1>
      <p class="lead">15 interactive problems practicing <strong>M</strong> (mirror left–right) and <strong>R</strong> (rotate 90° clockwise). You have <strong>45 minutes</strong>.</p>
    </div>

    <div class="topbar" role="region" aria-label="Timer and progress">
      <div class="timer" id="timer" title="Countdown timer">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" style="opacity:.9"><path d="M12 7v6l4 2" stroke="#4f46e5" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><path d="M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z" stroke="#4f46e5" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span id="timeText">45:00</span>
      </div>
    </div>
  </header>

  <main>
    <section class="quiz" id="quiz">
      <!-- Questions will be rendered here by JS -->
    </section>

    <div class="controls">
      <div>
        <button class="btn" id="submitBtn">Submit answers & get feedback</button>
        <button class="btn secondary" id="resetBtn" title="Reset all answers">Reset</button>
      </div>
      <div class="small">Questions: <strong>15</strong> · Time limit: <strong>45 minutes</strong></div>
    </div>

    <div id="feedbackArea" aria-live="polite"></div>
  </main>

  <footer>
    <div><strong>How it works</strong></div>
    <div class="small">Each question shows a starting object and a sequence of operations applied left-to-right. <strong>R</strong> adds a 90° clockwise rotation; <strong>M</strong> flips the image left–right in its current orientation. The quiz computes the final orientation and mirror state and gives a step-by-step explanation after you submit.</div>
  </footer>

  <script>
    /************************************************************************
     * Interactive quiz engine
     * - Generates 15 transformation questions (start orientation + sequence)
     * - R = rotate 90° clockwise; M = mirror left-right (flip horizontally)
     * - JS computes final rotation and mirror state, builds options (1 correct + 3 distractors)
     * - 45-minute countdown timer
     * - Submit button evaluates answers and shows detailed explanations per question
     ************************************************************************/

    // Utility: normalize rotation to 0/90/180/270
    function normRot(r){ r = ((r % 360) + 360) % 360; return r; }

    // Compute final state given startRotation (0=up,90=right,180=down,270=left) and sequence string like "R R M R"
    function computeFinal(startRot, seq){
      let rot = startRot; // degrees clockwise from up
      let mirrored = false; // false = normal, true = mirrored (left-right flip applied odd times)
      const ops = seq.trim().split(/\s+/).filter(Boolean);
      for(const op of ops){
        if(op === 'R'){
          rot = normRot(rot + 90);
        } else if(op === 'M'){
          // Mirror flips horizontally in current orientation.
          // For our representation we can toggle mirrored flag and keep rotation unchanged.
          mirrored = !mirrored;
        }
      }
      return { rotation: normRot(rot), mirrored: !!mirrored, ops };
    }

    // Human-friendly description for rotation
    function rotationLabel(rot){
      switch(normRot(rot)){
        case 0: return 'upright (0°)';
        case 90: return 'rotated 90° clockwise (right)';
        case 180: return 'rotated 180° (down)';
        case 270: return 'rotated 270° clockwise (left)';
        default: return rot + '°';
      }
    }

    // Friendly short direction for arrow-like objects
    function directionFromRotation(rot){
      switch(normRot(rot)){
        case 0: return 'up';
        case 90: return 'right';
        case 180: return 'down';
        case 270: return 'left';
      }
    }

    // Questions dataset (15). Each item: id, title, startDescription, startRotation (0 up, 90 right, ...), startFacing (for "facing" objects), sequence
    const QUESTIONS = [
      { id:1, title:'Arrow', start:'arrow pointing up', startRotation:0, sequence:'R R M R' },
      { id:2, title:'Letter F', start:'capital letter F upright', startRotation:0, sequence:'M R R' },
      { id:3, title:'Cat silhouette', start:'cat facing right', startRotation:90, sequence:'R M R R' },
      { id:4, title:'Clock face', start:'clock with 12 at top', startRotation:0, sequence:'R R R M' },
      { id:5, title:'Person with phone', start:'person facing forward; phone in their right hand (viewer sees it on left)', startRotation:0, sequence:'M R M' },
      { id:6, title:'Map landmark', start:'map with landmark to the east (right)', startRotation:0, sequence:'R R M R R' },
      { id:7, title:'Letter L', start:'capital letter L upright', startRotation:0, sequence:'M M R' },
      { id:8, title:'Traffic arrow', start:'arrow pointing left', startRotation:270, sequence:'R R R R M' },
      { id:9, title:'House icon', start:'house upright; door on the right', startRotation:0, sequence:'R M R M R' },
      { id:10, title:'Person silhouette', start:'person silhouette facing left', startRotation:270, sequence:'M R R M R' },
      { id:11, title:'Digit 2', start:'number 2 upright', startRotation:0, sequence:'R R R M R R' },
      { id:12, title:'Flag with star', start:'flag with star on the left edge', startRotation:0, sequence:'M R M R R' },
      { id:13, title:'Play triangle', start:'right-facing triangle (play button)', startRotation:90, sequence:'R M M R' },
      { id:14, title:'Person with hat', start:'person with hat tilted to their left shoulder', startRotation:0, sequence:'R R M R M R' },
      { id:15, title:'Car icon', start:'car facing forward (headlights at top)', startRotation:0, sequence:'M R R R M R R' }
    ];

    // Build the quiz UI
    const quizEl = document.getElementById('quiz');

    // For each question, compute final and create options (1 correct + 3 distractors)
    QUESTIONS.forEach((q, idx) => {
      const final = computeFinal(q.startRotation, q.sequence);
      // Build three distractors by varying rotation or mirror
      const distractors = [];
      const rotations = [0,90,180,270].filter(r => r !== final.rotation);
      // pick two rotations different and one mirror toggle of correct
      distractors.push({ rotation: rotations[0], mirrored: final.mirrored });
      distractors.push({ rotation: rotations[1 % rotations.length], mirrored: !final.mirrored });
      distractors.push({ rotation: rotations[2 % rotations.length], mirrored: final.mirrored });
      // shuffle and insert correct
      const options = distractors.slice(0,3).map(d => ({...d}));
      options.push({ rotation: final.rotation, mirrored: final.mirrored, correct:true });
      // shuffle options
      for(let i=options.length-1;i>0;i--){
        const j=Math.floor(Math.random()*(i+1));
        [options[i],options[j]]=[options[j],options[i]];
      }

      // Create card element
      const card = document.createElement('article');
      card.className = 'card';
      card.id = 'q'+q.id;
      card.innerHTML = `
        <div class="clip" aria-hidden="true">
          <!-- small illustrative SVG that rotates and mirrors in explanation -->
          <svg viewBox="0 0 64 64" width="64" height="64" id="svg${q.id}">
            <rect x="6" y="6" width="52" height="52" rx="8" fill="rgba(79,70,229,0.06)"/>
            <g id="shape${q.id}" transform="">
              <!-- simple icon: a rounded rectangle with a small asymmetric mark to show mirroring -->
              <rect x="18" y="18" width="28" height="28" rx="6" fill="#ffd8a8" stroke="#ffb86b" stroke-width="1.5"/>
              <path d="M34 26c0 2-3 2-3 4s3 2 3 4" stroke="#7c3aed" stroke-width="2" stroke-linecap="round" fill="none"/>
            </g>
          </svg>
        </div>
        <div class="qbody">
          <div class="qhead">
            <div class="qnum">Q${idx+1}</div>
            <div class="qtext">${q.title} — <span class="small">${q.start}</span></div>
            <div class="sequence" title="Operations sequence">${q.sequence}</div>
          </div>
          <div class="options" role="radiogroup" aria-label="Answer choices">
            ${options.map((opt,i)=>`
              <label class="option" data-rotation="${opt.rotation}" data-mirrored="${opt.mirrored ? '1':'0'}">
                <input type="radio" name="q${q.id}" value="${i}" aria-label="Option ${i+1}">
                <div>
                  <div style="font-weight:700">${rotationLabel(opt.rotation)}${opt.mirrored ? ' · mirrored' : ''}</div>
                  <div class="small">(${directionFromRotation(opt.rotation)}${opt.mirrored ? ', left-right flipped' : ''})</div>
                </div>
              </label>
            `).join('')}
          </div>
          <div class="explain" id="explain${q.id}" aria-live="polite"></div>
        </div>
      `;
      quizEl.appendChild(card);

      // Apply a small visual transform to the clip SVG to preview the starting orientation
      const svgGroup = card.querySelector('#shape'+q.id);
      // show starting rotation visually
      svgGroup.setAttribute('transform', `rotate(${q.startRotation} 32 32)`);
    });

    // Make option labels clickable and toggle radio
    document.querySelectorAll('.option').forEach(label => {
      label.addEventListener('click', (e) => {
        const input = label.querySelector('input[type=radio]');
        input.checked = true;
        // highlight selection
        const group = label.closest('.options');
        group.querySelectorAll('.option').forEach(l => l.style.boxShadow = '');
        label.style.boxShadow = '0 8px 30px rgba(79,70,229,0.08)';
      });
    });

    // Timer (45 minutes)
    const TOTAL_SECONDS = 45 * 60;
    let remaining = TOTAL_SECONDS;
    const timeText = document.getElementById('timeText');
    let timerInterval = null;

    function formatTime(s){
      const mm = String(Math.floor(s/60)).padStart(2,'0');
      const ss = String(s%60).padStart(2,'0');
      return `${mm}:${ss}`;
    }

    function startTimer(){
      timeText.textContent = formatTime(remaining);
      timerInterval = setInterval(() => {
        remaining--;
        if(remaining < 0){
          clearInterval(timerInterval);
          timeText.textContent = '00:00';
          // Auto-submit when time runs out
          submitAnswers(true);
          return;
        }
        timeText.textContent = formatTime(remaining);
        // change color when <5 minutes
        if(remaining <= 300){
          document.getElementById('timer').style.color = 'var(--bad)';
        }
      }, 1000);
    }
    startTimer();

    // Evaluate answers on submit
    const submitBtn = document.getElementById('submitBtn');
    const resetBtn = document.getElementById('resetBtn');
    const feedbackArea = document.getElementById('feedbackArea');

    function submitAnswers(auto=false){
      // stop timer if manual submit
      if(!auto && timerInterval) { clearInterval(timerInterval); timerInterval = null; }
      let correctCount = 0;
      const total = QUESTIONS.length;
      const details = [];

      QUESTIONS.forEach(q => {
        const card = document.getElementById('q'+q.id);
        const chosenInput = card.querySelector('input[type=radio]:checked');
        const explainEl = document.getElementById('explain'+q.id);
        const final = computeFinal(q.startRotation, q.sequence);

        // Build step-by-step explanation
        const steps = [];
        let rot = q.startRotation;
        let mirrored = false;
        steps.push(`Start: ${rotationLabel(rot)}${mirrored ? ' · mirrored' : ''}.`);
        const ops = q.sequence.trim().split(/\s+/).filter(Boolean);
        ops.forEach((op, i) => {
          if(op === 'R'){
            rot = normRot(rot + 90);
            steps.push(`After operation ${i+1} (R): rotate 90° clockwise → ${rotationLabel(rot)}.`);
          } else if(op === 'M'){
            mirrored = !mirrored;
            steps.push(`After operation ${i+1} (M): mirror left–right → ${mirrored ? 'mirrored' : 'not mirrored'} (rotation unchanged).`);
          }
        });
        steps.push(`Final state: ${rotationLabel(rot)}; ${mirrored ? 'mirrored (left–right flipped)' : 'not mirrored (normal)'} .`);

        // Determine correctness
        let userCorrect = false;
        let userChoiceText = 'No answer selected';
        if(chosenInput){
          const parent = chosenInput.closest('.option');
          const r = parseInt(parent.getAttribute('data-rotation'),10);
          const m = parent.getAttribute('data-mirrored') === '1';
          userChoiceText = `${rotationLabel(r)}; ${m ? 'mirrored' : 'not mirrored'}`;
          if(r === final.rotation && m === final.mirrored) userCorrect = true;
        }

        if(userCorrect) correctCount++;

        // Show explanation in the card
        explainEl.innerHTML = `
          <div><strong>${userCorrect ? '<span class="correct">Correct</span>' : '<span class="wrong">Incorrect</span>'}</strong> — your choice: <span style="font-weight:700">${userChoiceText}</span></div>
          <div style="margin-top:6px">${steps.map(s => `<div class="small">• ${s}</div>`).join('')}</div>
          <div style="margin-top:8px" class="small"><strong>Tip:</strong> Track rotation modulo 360° (each R adds 90°) and toggle mirror state on each M.</div>
        `;

        details.push({ qid:q.id, correct:userCorrect, final, steps });
      });

      // Build overall feedback
      feedbackArea.innerHTML = `
        <div class="results" role="status">
          <div style="display:flex;justify-content:space-between;align-items:center">
            <div><strong>Score:</strong> ${correctCount} / ${total}</div>
            <div><strong>Time left:</strong> ${timerInterval ? formatTime(remaining) : formatTime(remaining)}</div>
          </div>
          <div style="margin-top:8px" class="small">Detailed explanations are shown under each question. You can reset to try again.</div>
        </div>
      `;

      // Scroll to feedback
      feedbackArea.scrollIntoView({behavior:'smooth'});
    }

    submitBtn.addEventListener('click', () => submitAnswers(false));

    resetBtn.addEventListener('click', () => {
      // clear selections and explanations, restart timer
      document.querySelectorAll('input[type=radio]').forEach(r => r.checked = false);
      document.querySelectorAll('.option').forEach(l => l.style.boxShadow = '');
      document.querySelectorAll('.explain').forEach(e => e.innerHTML = '');
      feedbackArea.innerHTML = '';
      // reset timer
      if(timerInterval) clearInterval(timerInterval);
      remaining = TOTAL_SECONDS;
      startTimer();
      window.scrollTo({top:0,behavior:'smooth'});
    });

    // Accessibility: allow keyboard selection of options
    document.addEventListener('keydown', (e) => {
      if(e.key === 'Enter' && document.activeElement && document.activeElement.classList.contains('option')){
        document.activeElement.click();
      }
    });

    // Prevent accidental navigation: warn if timer running and user tries to close
    window.addEventListener('beforeunload', (e) => {
      if(timerInterval){
        e.preventDefault();
        e.returnValue = '';
      }
    });
  </script>
</body>
</html>
